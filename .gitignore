# Environment secrets
.env

# Bind-mount host paths (readable layout of the estate). Loaded explicitly with
# `docker compose --env-file host-paths.env ...` — the compose files reference
# each value as ${VAR:?...}, so omitting the flag fails loudly. Kept out of the
# tracked compose files because this repo is public (ADMIN_ACTIONS #19).
host-paths.env

# Legacy local gateway config. Config is DB-backed (seeded in code via
# src/api/config.py SEED_CONFIG). The YAML file itself was deleted 2026-09-18
# after the stale references were purged; the rule stays so it cannot come
# back unnoticed.
config/gateway.yaml

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
*.egg-info/
.venv/
build/
dist/

# Editor/tooling scratch copies (`foo.py,cover`). Untracked but were not
# ignored, so they polluted git status and grep/ripgrep results.
*,cover

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker volumes

# SQLite databases
data/*.db
data/*.db-shm
data/*.db-wal
lcp_dev_data/

# On-disk secret-key fallback (used when LCP_SECRET_KEY is unset)
data/.lcp_secret_key

# Runtime data (API keys, DB, etc.)
data/*.json
*.db
*.sqlite

# Secret-bearing backups of .env (untracked, must never be committed)
.env.bak*
.env.*.bak*
